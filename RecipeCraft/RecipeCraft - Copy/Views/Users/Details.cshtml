@model RecipeCraft.Models.User

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm p-4">
        <h2>👤 Преглед на потребител</h2>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Id:</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Username:</dt>
            <dd class="col-sm-8">@Model.Username</dd>

            <dt class="col-sm-4">Име и Фамилия:</dt>
            <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-4">Email:</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">PasswordHash:</dt>
            <dd class="col-sm-8"><code>@Model.PasswordHash</code></dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>
</div>