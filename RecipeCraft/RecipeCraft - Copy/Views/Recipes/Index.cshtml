@model IEnumerable<RecipeCraft.Models.Recipe>

@{
    ViewData["Title"] = "Списък с рецепти";
}

<div class="container mt-4">
    <h2 class="mb-4">📜 Списък с рецепти</h2>

    <!-- ФОРМА ЗА ТЪРСЕНЕ И ФИЛТРИРАНЕ -->
    <form asp-action="Index" method="get" class="card card-body bg-light mb-4 shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                       class="form-control" placeholder="Търси по име или съставка..." />
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="">-- Всички категории --</option>
                    <option value="Основни" selected="@(ViewData["CurrentCategory"]?.ToString() == "Основни")">Основни</option>
                    <option value="Супи" selected="@(ViewData["CurrentCategory"]?.ToString() == "Супи")">Супи</option>
                    <option value="Десерти" selected="@(ViewData["CurrentCategory"]?.ToString() == "Десерти")">Десерти</option>
                    <option value="Салати" selected="@(ViewData["CurrentCategory"]?.ToString() == "Салати")">Салати</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">🔍 Търси / Филтрирай</button>
            </div>
        </div>
    </form>

    <!-- БУТОНИ: НОВА РЕЦЕПТА (САМО ЗА ВЛЕЗЛИ) И НАСТРОЙКИ (SINGLETON) -->
    <div class="d-flex gap-2 mb-3">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-success">+ Добави нова рецепта</a>
        }

        <!-- БУТОН КЪМ SINGLETON НАСТРОЙКИТЕ -->
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">
            ⚙️ Настройки
        </a>
    </div>

    <!-- ТАБЛИЦА С РЕЦЕПТИ -->
    <table class="table table-hover table-striped border shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th>Време (мин)</th>
                <th>Продукти</th>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <th class="text-center">Действия</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Няма намерени рецепти. Добавете първата си рецепта!
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td><span class="badge bg-info text-dark">@item.Category</span></td>
                        <td>⏱️ @item.PrepTimeMinutes мин</td>
                        <td>@item.Ingredients</td>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Редактирай</a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                                }
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>