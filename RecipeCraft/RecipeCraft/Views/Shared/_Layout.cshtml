<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecipeCraft</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecipeCraft.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom shadow-sm mb-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <!-- Изображението на логото -->
                    <img src="~/images/recipecraft-logo.png"
                         alt="RecipeCraft Logo"
                         class="d-inline-block align-top me-2"
                         style="height: 60px; width: auto;" /> <!-- Настрой височината според нуждите си -->
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item me-3">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                Начало
                            </a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link text-white" asp-controller="Recipes" asp-action="Index">Всички pецепти</a>
                        </li>

                        @* ЛИНКОВЕ САМО ЗА ВЛЕЗЛИ ПОТРЕБИТЕЛИ *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-info" asp-controller="Recipes" asp-action="MyRecipes">Моите рецепти</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link text-warning" asp-controller="Favorites" asp-action="Index">Любими</a>
                            </li>
                        }

                        @* ЛИНКОВЕ САМО ЗА АДМИН *@
                        @if (User.IsInRole("Admin") || User.Identity?.Name == "admin")
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link" asp-controller="Category" asp-action="Index">Категории</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link text-info" asp-controller="Users" asp-action="Index">Управление на Потребители</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                           <li class="nav-item me-3">
                                <a class="nav-link fw-bold" asp-controller="Users" asp-action="Profile" title="Моят профил">
                                    @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Users" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3">
                                        Изход
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <!-- КУТИЯ С ЯСЕН ТЪМЕН ТЕКСТ ВЪРХУ ЖЪЛТ ФОН -->
                                <a class="btn btn-brand-login px-3 py-1 shadow-sm" asp-controller="Users" asp-action="Login">
                                    Вход / Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RecipeCraft - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>