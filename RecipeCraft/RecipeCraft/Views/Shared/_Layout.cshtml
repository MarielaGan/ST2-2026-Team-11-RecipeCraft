<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecipeCraft</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecipeCraft.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🍳 RecipeCraft</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recipes" asp-action="Index">📖 Всички Рецепти</a>
                        </li>

                        @* ЛИНК КЪМ ЛЮБИМИ РЕЦЕПТИ (САМО ЗА ВЛЕЗЛИ ПОТРЕБИТЕЛИ) *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Favorites" asp-action="Index">⭐ Любими</a>
                            </li>
                        }

                        @* ЛИНК КЪМ КАТЕГОРИИ И ПОТРЕБИТЕЛИ (САМО ЗА АДМИН) *@
                        @if (User.IsInRole("Admin") || User.Identity?.Name == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Category" asp-action="Index">📂 Категории</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-controller="Users" asp-action="Index">👥 Управление на Потребители</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <a asp-controller="Users" asp-action="Profile" class="nav-link text-light p-0 me-2" title="Преглед на профила">
                                    👤 Моят профил (<strong>@User.Identity.Name</strong>)
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <form asp-controller="Users" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Изход
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-controller="Users" asp-action="Login" class="btn btn-outline-light ms-auto">
                                    Вход / Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RecipeCraft - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>