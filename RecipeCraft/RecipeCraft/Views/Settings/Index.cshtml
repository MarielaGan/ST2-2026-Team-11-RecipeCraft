@model ST2_2026_Team_10_RecipeCraft.Services.AppSettingsModel

<h2>⚙️ Настройки на сайта (Singleton AppSettings)</h2>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form asp-action="Index" method="post" class="mt-4">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="SiteTitle" class="form-label">Заглавие на сайта</label>
        <input asp-for="SiteTitle" class="form-control" />
        <span asp-validation-for="SiteTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RecipesPerPage" class="form-label">Рецепти на страница</label>
        <input asp-for="RecipesPerPage" type="number" class="form-control" />
        <span asp-validation-for="RecipesPerPage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AdminEmail" class="form-label">Имейл на администратора</label>
        <input asp-for="AdminEmail" class="form-control" />
        <span asp-validation-for="AdminEmail" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="EnableAiAssistant" class="form-check-input" type="checkbox" />
        <label asp-for="EnableAiAssistant" class="form-check-label">Активирай AI Асистент</label>
    </div>

    <button type="submit" class="btn btn-primary">Запази настройките</button>
</form>
