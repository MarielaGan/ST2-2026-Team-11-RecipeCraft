@{
    ViewData["Title"] = "Добре дошли в RecipeCraft";
}

<div class="container py-5">
    <!-- HERO SECTION -->
    <div class="p-5 mb-5 mb-4 bg-dark text-white rounded-3 shadow text-center">
        <h1 class="display-4 fw-bold">🍳 Добре дошли в RecipeCraft!</h1>
        <p class="fs-4">Открийте страхотни рецепти или споделете вашите кулинарни шедьоври.</p>
        <a asp-controller="Recipes" asp-action="Index" class="btn btn-outline-light btn-lg px-4 mt-2">
            📖 Разгледай всички рецепти без регистрация
        </a>
    </div>

    <!-- ЛОГИН И РЕГИСТРАЦИЯ ФОРМИ -->
    <div class="row g-4 mt-2">
        <!-- ВХОД -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">🔑 Вход в профила</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <div asp-validation-summary="All" class="mb-0"></div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }
                        <div class="mb-3">
                            <label class="form-label fw-bold">Потребителско име</label>
                            <input type="text" name="username" class="form-control" required placeholder="Вашето потребителско име..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Парола</label>
                            <input type="password" name="password" class="form-control" required placeholder="Вашата парола..." />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Влез</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- БЪРЗА РЕГИСТРАЦИЯ -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0">📝 Бърза регистрация</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Users" asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Потребителско име</label>
                            <input type="text" name="Username" class="form-control" required placeholder="Изберете username..." />
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">Име</label>
                                <input type="text" name="FirstName" class="form-control" required placeholder="Иван" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Фамилия</label>
                                <input type="text" name="LastName" class="form-control" required placeholder="Иванов" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Имейл</label>
                            <input type="email" name="Email" class="form-control" required placeholder="ivan@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Парола</label>
                            <input type="password" name="PasswordHash" class="form-control" required placeholder="Парола..." />
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Регистрирай се</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>