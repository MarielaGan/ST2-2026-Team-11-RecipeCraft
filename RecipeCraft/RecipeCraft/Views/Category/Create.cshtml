@model RecipeCraft.Models.Category

@{
    ViewData["Title"] = "Нова Категория";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4" style="color: #1a1a1a;">Създаване на Категория</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-4">
                    <label asp-for="Name" class="form-label fw-medium text-dark">Име на категорията</label>
                    <input asp-for="Name" class="form-control" style="border-radius: 8px; border: 1px solid #ced4da;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn fw-bold px-4 py-2" style="background-color: #f5c23b; color: #2d1a0e; border-radius: 8px; border: none;">
                        Запази
                    </button>
                    <a asp-action="Index" class="btn fw-bold px-4 py-2" style="background-color: #5a3e2b; color: #ffffff; border-radius: 8px;">
                        Отказ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}