@model IEnumerable<RecipeCraft.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold m-0" style="color: #1a1a1a;">Категории</h1>
    <a asp-action="Create" class="btn fw-bold px-4 py-2" style="background-color: #f5c23b; color: #2d1a0e; border-radius: 8px;">
        Нова Категория
    </a>
</div>

<div class="table-responsive shadow-sm" style="border-radius: 12px; overflow: hidden; background-color: #fff;">
    <table class="table table-borderless align-middle m-0">
        <thead style="background-color: #2d1a0e; color: #f5c23b;">
            <tr>
                <th class="py-3 px-4 fw-bold">Име на категорията</th>
                <th class="py-3 px-4 fw-bold text-end" style="width: 220px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="border-bottom: 1px solid #f0f0f0;">
                    <td class="py-3 px-4 fw-medium text-dark">
                        @item.Name
                    </td>
                    <td class="py-3 px-4 text-end">
                        <div class="d-inline-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm fw-bold px-3 py-1"
                               style="background-color: #f5c23b; color: #2d1a0e; border-radius: 6px;">
                                Редакция
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm fw-bold px-3 py-1"
                               style="background-color: #fff; color: #d9534f; border: 1px solid #d9534f; border-radius: 6px;">
                                Изтрий
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>