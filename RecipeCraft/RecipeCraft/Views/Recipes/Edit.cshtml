@model RecipeCraft.Models.Recipe

<div class="container mt-4" style="max-width: 600px;">
    <h2>✏️ Редакция на рецепта</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body shadow-sm mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="CreatedOn" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold"></label>
            <input asp-for="Title" class="form-control" placeholder="напр. Мусака" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label fw-bold">Категория</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                <option value="">-- Изберете категория --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PrepTimeMinutes" class="form-label fw-bold"></label>
            <input asp-for="PrepTimeMinutes" type="number" class="form-control" />
            <span asp-validation-for="PrepTimeMinutes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Снимка на рецептата</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ImageUrl" alt="Текуща снимка" class="img-thumbnail" style="max-height: 120px;" />
                </div>
            }
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="mb-3">
            <label asp-for="Ingredients" class="form-label fw-bold"></label>
            <textarea asp-for="Ingredients" class="form-control" rows="3" placeholder="Кайма, картофи, лук..."></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Instructions" class="form-label fw-bold"></label>
            <textarea asp-for="Instructions" class="form-control" rows="4" placeholder="Запържете каймата..."></textarea>
            <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a asp-action="MyRecipes" class="btn btn-outline-secondary">Отказ</a>
            <button type="submit" class="btn btn-primary">Запази промените</button>
        </div>
    </form>
</div>