@model RecipeCraft.Models.Recipe

<div class="container mt-4" style="max-width: 600px;">
    <h2>➕ Добавяне на нова рецепта</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body shadow-sm mt-3">
        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">Име на рецептата</label>
            <input asp-for="Title" class="form-control" placeholder="напр. Мусака" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label fw-bold">Категория</label>
            <div class="input-group">
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value="">-- Изберете категория --</option>
                </select>
                @if (User.IsInRole("Admin") || User.Identity?.Name == "admin")
                {
                    <a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary" target="_blank" title="Добави нова категория в нов раздел">
                        + Добави категория
                    </a>
                }
            </div>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <!-- ПОЛЕ ЗА СНИМКА -->
        <div class="mb-3">
            <label class="form-label fw-bold">Снимка на ястието</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="mb-3">
            <label asp-for="PrepTimeMinutes" class="form-label fw-bold">Време за приготвяне (в минути)</label>
            <input asp-for="PrepTimeMinutes" type="number" class="form-control" value="30" />
            <span asp-validation-for="PrepTimeMinutes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Ingredients" class="form-label fw-bold">Необходими съставки</label>
            <textarea asp-for="Ingredients" class="form-control" rows="3" placeholder="Кайма, картофи, лук..."></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Instructions" class="form-label fw-bold">Начин на приготвяне</label>
            <textarea asp-for="Instructions" class="form-control" rows="4" placeholder="Запържете каймата..."></textarea>
            <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            <button type="submit" class="btn btn-success">Запази рецептата</button>
        </div>
    </form>
</div>