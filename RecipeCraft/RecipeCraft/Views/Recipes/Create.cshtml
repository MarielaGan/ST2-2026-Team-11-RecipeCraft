@model RecipeCraft.Models.Recipe

<div class="container mt-4" style="max-width: 600px;">
    <h2>➕ Добавяне на нова рецепта</h2>

    <form asp-action="Create" method="post" class="card card-body shadow-sm mt-3">
        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold"></label>
            <input asp-for="Title" class="form-control" placeholder="напр. Мусака" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label fw-bold"></label>
            <select asp-for="Category" class="form-select">
                <option value="Основни">Основни</option>
                <option value="Десерти">Десерти</option>
                <option value="Супи">Супи</option>
                <option value="Салати">Салати</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PrepTimeMinutes" class="form-label fw-bold"></label>
            <input asp-for="PrepTimeMinutes" type="number" class="form-control" value="30" />
            <span asp-validation-for="PrepTimeMinutes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Ingredients" class="form-label fw-bold"></label>
            <textarea asp-for="Ingredients" class="form-control" rows="3" placeholder="Кайма, картофи, лук..."></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Instructions" class="form-label fw-bold"></label>
            <textarea asp-for="Instructions" class="form-control" rows="4" placeholder="Запържете каймата..."></textarea>
            <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            <button type="submit" class="btn btn-success">Запази рецептата</button>
        </div>
    </form>
</div>
