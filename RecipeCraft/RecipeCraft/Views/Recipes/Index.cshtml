@model IEnumerable<RecipeCraft.Models.Recipe>

@{
    ViewData["Title"] = "Списък с рецепти";
}

<div class="container mt-4">
    <h2 class="mb-4">📜 Списък с рецепти</h2>

    <!-- 1. ТЪРСЕНЕ НА ЕСТЕСТВЕН ЕЗИК С GEMINI AI -->
    <div class="card mb-4 border-warning shadow-sm">
        <div class="card-header bg-warning bg-gradient text-dark fw-bold d-flex align-items-center justify-content-between">
            <span>✨ Умно търсене с Gemini AI</span>
            @if (!string.IsNullOrWhiteSpace(ViewBag.AiQuery))
            {
                <span class="badge bg-dark">Активен ИИ филтър</span>
            }
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="input-group">
                    <input type="text" name="aiQuery" value="@ViewBag.AiQuery" class="form-control"
                           placeholder="Напр.: 'намери десерти с ягоди' или 'бързи супи'..." />
                    <button type="submit" class="btn btn-dark">Търси с AI 🤖</button>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.AiQuery))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
                    }
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    <strong>Предупреждение:</strong> @ViewBag.Error
                </div>
            }
        </div>
    </div>

    <!-- 2. СТАНДАРТНА ФОРМА ЗА ТЪРСЕНЕ И ФИЛТРИРАНЕ -->
    <form asp-action="Index" method="get" class="card card-body bg-light mb-4 shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                       class="form-control" placeholder="Търси по име или съставка..." />
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="">-- Всички категории --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<RecipeCraft.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Name)">
                                @cat.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">🔍 Търси / Филтрирай</button>
            </div>
        </div>
    </form>

    <!-- 3. БУТОНИ: НОВА РЕЦЕПТА, ДОБАВИ КАТЕГОРИЯ (АДМИН) И НАСТРОЙКИ -->
    <div class="d-flex gap-2 mb-3">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-success">+ Добави нова рецепта</a>

            @if (User.IsInRole("Admin") || User.Identity.Name == "admin")
            {
                <a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary">
                    📂 Добави категория
                </a>
            }
        }

        <!-- БУТОН КЪМ SINGLETON НАСТРОЙКИТЕ -->
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">
            ⚙️ Настройки
        </a>
    </div>

    <!-- 4. ТАБЛИЦА С РЕЦЕПТИ -->
    <table class="table table-hover table-striped border shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th>Време (мин)</th>
                <th>Продукти</th>
                <th>Автор / Дата</th> 
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <th class="text-center">Действия</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Няма намерени рецепти. Добавете първата си рецепта!
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @(item.Category != null ? item.Category.Name : "Без категория")
                            </span>
                        </td>
                        <td>⏱️ @item.PrepTimeMinutes мин</td>
                        <td>@item.Ingredients</td>

                        <!-- НОВА КЛЕТКА ЗА АВТОР И ДАТА -->
                        <td>
                            <small class="text-muted d-block">👤 @item.CreatedBy</small>
                            <small class="text-muted">📅 @item.CreatedOn.ToString("dd.MM.yyyy HH:mm")</small>
                        </td>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <td class="text-center">
                                <!-- БУТОН ЗА ЛЮБИМИ (⭐) -->
                                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                                    <input type="hidden" name="recipeId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Добави / Премахни от любими">
                                        ⭐
                                    </button>
                                </form>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Редактирай</a>

                                @if (User.IsInRole("Admin") || User.Identity.Name == "admin")
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                                }
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>