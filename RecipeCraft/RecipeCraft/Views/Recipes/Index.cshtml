@model IEnumerable<RecipeCraft.Models.Recipe>

<div class="container mt-4">
    <h2>📜 Списък с рецепти</h2>

    <!-- ФОРМА ЗА ФИЛТРИРАНЕ И ТЪРСЕНЕ -->
    <form method="get" asp-action="Index" class="card card-body bg-light mb-4 mt-3">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Търси по име или съставка..." />
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="">-- Всички категории --</option>
                    <option value="Основни">Основни</option>
                    <option value="Десерти">Десерти</option>
                    <option value="Супи">Супи</option>
                    <option value="Салати">Салати</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">🔍 Търси / Филтрирай</button>
            </div>
        </div>
    </form>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">+ Добави нова рецепта</a>
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary ms-2">⚙️ Настройки (Singleton)</a>
    </div>

    <!-- ТАБЛИЦА С РЕЦЕПТИ -->
    <table class="table table-hover table-striped border">
        <thead class="table-dark">
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th>Време (мин)</th>
                <th>Продукти</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">Няма намерени рецепти. Добавете първата си рецепта!</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td><span class="badge bg-info text-dark">@item.Category</span></td>
                        <td>⏱️ @item.PrepTimeMinutes мин</td>
                        <td>@item.Ingredients</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
