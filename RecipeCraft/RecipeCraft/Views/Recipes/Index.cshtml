@using RecipeCraft.Services
@model RecipeCraft.Models.PaginatedList<RecipeCraft.Models.Recipe>

@{
    ViewData["Title"] = "Списък с рецепти";
}

<div class="container mt-4">
    <h2 class="mb-4">Списък с рецепти</h2>

    <!-- 1. ТЪРСЕНЕ НА ЕСТЕСТВЕН ЕЗИК С GEMINI AI -->
    @if (AppSettingsManager.Instance.Settings.EnableAiAssistant)
    {
        <div class="card mb-4 border-warning shadow-sm">
            <div class="card-header bg-warning bg-gradient text-dark fw-bold d-flex align-items-center justify-content-between">
                <span>Умно търсене с Gemini AI</span>
                @if (!string.IsNullOrWhiteSpace(ViewBag.AiQuery))
                {
                    <span class="badge bg-dark">Активен ИИ филтър</span>
                }
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="aiQuery" value="@ViewBag.AiQuery" class="form-control"
                               placeholder="Напр.: 'намери десерти с ягоди' или 'бързи супи'..." />
                        <button type="submit" class="btn btn-dark">Търси с AI</button>
                        @if (!string.IsNullOrWhiteSpace(ViewBag.AiQuery))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
                        }
                    </div>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        <strong>Предупреждение:</strong> @ViewBag.Error
                    </div>
                }
            </div>
        </div>
    }

    <!-- 2. СТАНДАРТНА ФОРМА ЗА ТЪРСЕНЕ И ФИЛТРИРАНЕ -->
    <form asp-action="Index" method="get" class="card card-body bg-light mb-4 shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                       class="form-control" placeholder="Търси по име или съставка..." />
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="">-- Всички категории --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<RecipeCraft.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Name)">
                                @cat.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">🔍 Търси / Филтрирай</button>
            </div>
        </div>
    </form>

    <!-- 3. БУТОНИ: НОВА РЕЦЕПТА, ДОБАВИ КАТЕГОРИЯ И НАСТРОЙКИ -->
    <div class="d-flex gap-2 mb-4">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-brand-primary w-50 text-center fw-bold">+ Добави нова рецепта</a>

            @if (User.IsInRole("Admin") || User.Identity.Name == "admin")
            {
                <a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary">
                    Добави категория
                </a>
            }
        }

        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">
            Настройки
        </a>
    </div>

    <!-- 4. СЕКЦИЯ С КАРТИЧКИ ВМЕСТО ТАБЛИЦА -->
    <div class="row text-start">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <p class="fs-5">Няма намерени рецепти. Добавете първата си рецепта!</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 recipe-card overflow-hidden">
                        <!-- СНИМКА -->
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light text-center py-5 text-muted" style="height: 200px;">
                                📷 Няма снимка
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">
                            <!-- ИМЕ -->
                            <h5 class="card-title fw-bold mb-2" style="color: var(--brand-dark-brown);">@item.Title</h5>
                            
                            <!-- ВРЕМЕ -->
                            <p class="card-text text-muted small mb-3">
                                 Време за приготвяне: @item.PrepTimeMinutes мин
                            </p>
                            
                            <!-- БУТОН КЪМ ДЕТАЙЛИТЕ -->
                            <div class="mt-auto pt-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-brand-primary w-100 text-center fw-bold">
                                    Виж цялата рецепта →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- 5. БУТОНИ ЗА СМЯНА НА СТРАНИЦАТА (PAGINATION) -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 my-4">
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               asp-route-category="@ViewData["CurrentCategory"]"
               asp-route-aiQuery="@ViewBag.AiQuery"
               class="btn btn-outline-dark @(!Model.HasPreviousPage ? "disabled" : "")">
                ← Предишна
            </a>

            <span class="mx-2 fw-bold text-muted">
                Страница @Model.PageIndex от @Model.TotalPages
            </span>

            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               asp-route-category="@ViewData["CurrentCategory"]"
               asp-route-aiQuery="@ViewBag.AiQuery"
               class="btn btn-outline-dark @(!Model.HasNextPage ? "disabled" : "")">
                Следваща →
            </a>
        </div>
    }
</div>