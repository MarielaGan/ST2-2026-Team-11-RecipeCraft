@model RecipeCraft.Models.Recipe

@{
    ViewData["Title"] = "Изтриване на рецепта";
}

<h2 class="text-danger">Изтриване на рецепта</h2>
<h3>Сигурни ли сте, че искате да изтриете тази рецепта?</h3>

<div class="card p-3 my-3">
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Категория</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">Съставки</dt>
        <dd class="col-sm-9">@Model.Ingredients</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Изтрий</button> |
        <a asp-action="Index" class="btn btn-secondary">Отказ</a>
    </form>
</div>