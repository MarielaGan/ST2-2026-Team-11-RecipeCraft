@model IEnumerable<RecipeCraft.Models.User>

@{
    ViewData["Title"] = "Потребители";
}

<div class="container mt-4">
    <!-- ЗАГЛАВИЕ И БУТОН ЗА НОВ ПОТРЕБИТЕЛ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-brand-dark">Потребители</h2>
        <a asp-action="Create" class="btn btn-brand-primary px-3 py-2 shadow-sm">
            Нов потребител
        </a>
    </div>

    <!-- БЛОК ЗА ТЪРСЕНЕ И ФИЛТРИРАНЕ -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control form-control-auth" placeholder="Търси по име, username или email..." />
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select form-control-auth">
                    <option value="">-- Всички роли --</option>
                    <option value="Admin" selected="@(ViewData["CurrentRole"]?.ToString() == "Admin")">Admin</option>
                    <option value="User" selected="@(ViewData["CurrentRole"]?.ToString() == "User")">User</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-brand-primary flex-grow-1 shadow-sm">
                    Филтрирай
                </button>
                <a asp-action="Index" class="btn btn-brand-secondary">
                    Изчисти
                </a>
            </div>
        </form>
    </div>

    <!-- ТАБЛИЦА С ПОТРЕБИТЕЛИ -->
    <div class="card card-custom shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-brand-header">
                    <tr>
                        <th>Id</th>
                        <th>Username</th>
                        <th>Име и Фамилия</th>
                        <th>Email</th>
                        <th class="text-center">Роля</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Id</td>
                            <td class="fw-semibold text-brand-dark">@item.Username</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td class="text-muted">@item.Email</td>
                            
                            
                            <td class="text-center fw-semibold text-brand-dark">
                                @item.Role
                            </td>

                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm gap-1" role="group">
                                    
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-brand-secondary btn-sm rounded" title="Преглед">
                                        Преглед
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-brand-primary btn-sm rounded" title="Редакция">
                                        Редакция
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded" title="Изтрий">
                                        Изтрий
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>