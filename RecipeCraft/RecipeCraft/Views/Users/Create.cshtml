@model RecipeCraft.Models.User

@{
    ViewData["Title"] = "Добавяне на потребител";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6" style="max-width: 520px;">
        <div class="card shadow-sm auth-card border-0">

            <!-- ЖЪЛТА ЗАГЛАВНА ЛЕНТА -->
            <div class="card-header auth-card-header text-center py-3">
                <h3 class="mb-0 fw-bold">Добавяне на потребител</h3>
            </div>

            <!-- ФОРМА ЗА СЪЗДАВАНЕ -->
            <div class="card-body p-4 bg-white">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Потребителско име -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="Username" class="form-control form-control-auth" placeholder="напр. ivan99" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <!-- Име и Фамилия -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="FirstName" class="form-control form-control-auth" placeholder="Иван" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="LastName" class="form-control form-control-auth" placeholder="Иванов" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Имейл -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="Email" type="email" class="form-control form-control-auth" placeholder="ivan@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    
                    <div class="mb-4">
                        <label for="PasswordHash" class="form-label fw-semibold text-dark">Парола</label>
                        <input asp-for="PasswordHash" type="password" class="form-control form-control-auth" placeholder="Въведете парола..." />
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                    </div>

                    <!-- БУТОНИ -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-brand-secondary px-4">
                            Назад
                        </a>

                        <button type="submit" class="btn btn-brand-primary px-4 shadow-sm">
                            Запази
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}