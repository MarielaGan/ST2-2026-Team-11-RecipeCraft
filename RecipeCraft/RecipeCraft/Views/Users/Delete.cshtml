@model RecipeCraft.Models.User

@{
    ViewData["Title"] = "Изтриване на потребител";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="text-danger">🗑️ Изтриване на потребител</h2>
    <h3 class="fs-5 text-muted">Сигурни ли сте, че искате да изтриете този потребител?</h3>

    <div class="card p-3 my-3 shadow-sm border-danger">
        <h4>@Model.Username (@Model.FirstName @Model.LastName)</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Изтрий</button> |
            <a asp-action="Index" class="btn btn-secondary">Отказ</a>
        </form>
    </div>
</div>