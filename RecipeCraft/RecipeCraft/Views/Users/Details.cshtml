@model RecipeCraft.Models.User 

@{
    ViewData["Title"] = "Преглед на профил";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm profile-card">
            
            <!-- ЖЪЛТА ЗАГЛАВНА ЛЕНТА -->
            <div class="card-header profile-card-header text-center py-3">
                <h3 class="mb-0 fw-bold">Преглед на профил</h3>
            </div>

            <!-- СЪДЪРЖАНИЕ -->
            <div class="card-body p-4 bg-white">
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 fw-bold text-brand-dark">Username:</div>
                    <div class="col-sm-8 text-secondary">@Model.Username</div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 fw-bold text-brand-dark">Име и Фамилия:</div>
                    <div class="col-sm-8 text-secondary">@Model.FirstName @Model.LastName</div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 fw-bold text-brand-dark">Email:</div>
                    <div class="col-sm-8 text-secondary">@Model.Email</div>
                </div>
            </div>

            <!-- БУТОНИ В ПОДНОЖИЕТО -->
            <div class="card-footer bg-light p-3 border-0 d-flex justify-content-between flex-wrap gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand-secondary">
                    Към начална страница
                </a>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-brand-primary">
                        Редактирай профила
                    </a>
                    
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        Изтрий
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>