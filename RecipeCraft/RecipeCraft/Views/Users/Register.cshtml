@model RecipeCraft.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm auth-card border-0">
            <div class="card-header auth-card-header text-center py-3">
                <h3 class="mb-0 fw-bold">Създаване на профил</h3>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-controller="Users" asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="Username" class="form-control form-control-auth" placeholder="Изберете потребителско име..." />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="FirstName" class="form-control form-control-auth" placeholder="Иван" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="LastName" class="form-control form-control-auth" placeholder="Иванов" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="Email" class="form-control form-control-auth" placeholder="ivan@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="Password" type="password" class="form-control form-control-auth" placeholder="Въведете парола..." />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-auth" placeholder="Повторете паролата..." />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-auth-submit btn-lg fw-bold shadow-sm">Регистрирай се</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light border-0">
                <small class="text-muted">
                    Вече имате профил? 
                    <a asp-controller="Users" asp-action="Login" class="auth-link fw-bold ms-1">Влезте от тук</a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}